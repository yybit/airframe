<?xml version="1.0" encoding="utf-8"?>
<!--
  AirFrame MSI (WiX Toolset v5):

    dotnet tool install -g wix
    wix extension add -g WixToolset.UI.wixext/5.0.2

    wix build packaging/windows/airframe.wxs -arch x64 \
        -ext WixToolset.UI.wixext \
        -d Version=0.1.0 -d BinDir=target\release \
        -d IconPath=packaging\windows\airframe.ico \
        -out dist\AirFrame-0.1.0-windows-x64.msi

  Per-machine install into Program Files\AirFrame with a Start Menu
  shortcut and the standard WixUI_InstallDir wizard.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="AirFrame"
           Manufacturer="AirFrame Project"
           Version="$(var.Version)"
           UpgradeCode="328E2123-1B98-445B-8AFE-879628AADC39"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AirFrameIco" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AirFrameIco" />
    <Property Id="ARPHELPLINK" Value="https://github.com/yybit/airframe" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AirFrame">
        <Component Id="AirFrameExe" Bitness="always64">
          <File Id="AirFrameExeFile" Name="airframe.exe"
                Source="$(var.BinDir)\airframe.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="AirFrame">
        <Component Id="StartMenuShortcut">
          <Shortcut Id="AirFrameShortcut" Name="AirFrame"
                    Description="Remote desktop client for VNC, RDP and SPICE"
                    Target="[INSTALLFOLDER]airframe.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AirFrame" Name="installed"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="AirFrame"
             Description="Installs AirFrame and the Start Menu shortcut."
             Level="1" AllowAbsent="no">
      <ComponentRef Id="AirFrameExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
