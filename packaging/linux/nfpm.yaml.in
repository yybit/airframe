# nfpm config for the .deb and .rpm (https://nfpm.goreleaser.com).
# @PLACEHOLDER@ values are substituted by packaging/linux/package.sh.
name: airframe
arch: "@ARCH@" # amd64 | arm64; nfpm maps these to x86_64/aarch64 for rpm
platform: linux
version: "@VERSION@"
section: net
priority: optional
maintainer: yybit <yybit@users.noreply.github.com>
description: >-
  A native desktop remote desktop client for VNC, RDP and SPICE, with saved
  connections, auto-reconnect, clipboard sync and screenshots.
vendor: AirFrame Project
homepage: https://github.com/yybit/airframe
license: MIT OR Apache-2.0
contents:
  - src: @PACKROOT@/bin/airframe
    dst: /usr/bin/airframe
  - src: @PACKROOT@/share/applications/airframe.desktop
    dst: /usr/share/applications/airframe.desktop
  - src: @PACKROOT@/share/icons/hicolor/256x256/apps/airframe.png
    dst: /usr/share/icons/hicolor/256x256/apps/airframe.png
  - src: @PACKROOT@/share/icons/hicolor/512x512/apps/airframe.png
    dst: /usr/share/icons/hicolor/512x512/apps/airframe.png
